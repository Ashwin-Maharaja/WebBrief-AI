# OpenAI API Configuration (Required for webpage summarization)
OPENAI_API_KEY=your_openai_api_key_here

# Flask Security Configuration (Optional - auto-generated if omitted)
FLASK_SECRET_KEY=your_random_flask_secret_key_here
SESSION_COOKIE_SECURE=false

# Server Runtime Configuration (Optional - defaults shown)
FLASK_DEBUG=0
PORT=5000
HOST=127.0.0.1

