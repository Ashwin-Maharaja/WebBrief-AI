# =====================================================================
# WebBrief AI — Environment Configuration Template (v1.6.4)
# Copy this file to .env and configure your personal settings.
# NEVER commit your actual .env file or credentials to Git!
# =====================================================================

# ---------------------------------------------------------------------
# Primary AI Provider Configuration (Users need only one provider)
# Supported options: 'cloudflare' (recommended) or 'groq'
# ---------------------------------------------------------------------
PRIMARY_PROVIDER=cloudflare

# Cloudflare Workers AI Configuration (Primary Recommended Provider)
# Obtain your Account ID from Cloudflare Dashboard URL or Overview page.
# Create an API token at: Cloudflare Dashboard > My Profile > API Tokens > Workers AI
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_DEFAULT_MODEL=@cf/meta/llama-3.1-8b-instruct

# GroqCloud Configuration (Optional Fallback or Alternative Primary Provider)
# Create a free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_DEFAULT_MODEL=llama-3.1-8b-instant

# ---------------------------------------------------------------------
# Automatic Fallback Configuration (Optional)
# ---------------------------------------------------------------------
FALLBACK_ENABLED=false
FALLBACK_PROVIDER=groq
FALLBACK_MODEL=llama-3.1-8b-instant

# ---------------------------------------------------------------------
# Notion Integration (Optional — for exporting briefs to Notion)
# In local mode, saved to .env; in hosted mode, requires the encrypted Redis vault.
# ---------------------------------------------------------------------
# NOTION_API_KEY=secret_your_notion_integration_token_here

# ---------------------------------------------------------------------
# Flask Security Configuration (Required for production deployments)
# Production strictly requires an explicitly configured, secure secret key
# (minimum 32 characters / 16 bytes). Startup fails safely if missing or weak.
# In local development, an ephemeral 32-byte random key is generated automatically if empty.
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
# ---------------------------------------------------------------------
FLASK_SECRET_KEY=your_random_32_byte_secret_key_here
SESSION_COOKIE_SECURE=false

# ---------------------------------------------------------------------
# Server Runtime Configuration (Optional — defaults shown)
# ---------------------------------------------------------------------
FLASK_DEBUG=0
PORT=5000
HOST=127.0.0.1

# ---------------------------------------------------------------------
# Optional Redis Credential Vault & Distributed Rate Limiting (v1.6.4)
# When configured, visitor BYOK credentials are encrypted in managed Redis
# for temporary sessions (30-min sliding inactivity TTL, 8-hr max).
# Also provides cross-instance rate limiting across serverless Lambda instances.
# When omitted, standard in-memory BYOK and process-local rate limiting are used.
# ---------------------------------------------------------------------
# REDIS_URL=rediss://default:your-password@your-managed-redis-host:6379
# Generate Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CREDENTIAL_ENCRYPTION_KEY=your_base64_fernet_encryption_key_here
