# =====================================================================
# WebBrief AI — Environment Configuration Template (v1.6.2)
# Copy this file to .env and configure your personal settings.
# NEVER commit your actual .env file or credentials to Git!
# =====================================================================

# ---------------------------------------------------------------------
# Primary AI Provider Configuration (Users need only one provider)
# Supported options: 'cloudflare' (recommended) or 'groq'
# ---------------------------------------------------------------------
PRIMARY_PROVIDER=cloudflare

# Cloudflare Workers AI Configuration (Primary Recommended Provider)
# Obtain your Account ID from Cloudflare Dashboard URL or Overview page.
# Create an API token at: Cloudflare Dashboard > My Profile > API Tokens > Workers AI
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_DEFAULT_MODEL=@cf/meta/llama-3.1-8b-instruct

# GroqCloud Configuration (Optional Fallback or Alternative Primary Provider)
# Create a free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------------
# Automatic Fallback Configuration (Optional)
# ---------------------------------------------------------------------
FALLBACK_ENABLED=false
FALLBACK_PROVIDER=groq
FALLBACK_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------------
# Notion Integration (Optional — for exporting briefs to Notion)
# ---------------------------------------------------------------------
# NOTION_API_KEY=secret_your_notion_integration_token_here

# ---------------------------------------------------------------------
# Flask Security Configuration (Required for production deployments)
# ---------------------------------------------------------------------
# Generate a secure 32-byte secret key with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your_random_32_byte_secret_key_here
SESSION_COOKIE_SECURE=false

# ---------------------------------------------------------------------
# Server Runtime Configuration (Optional — defaults shown)
# ---------------------------------------------------------------------
FLASK_DEBUG=0
PORT=5000
HOST=127.0.0.1

# Optional v1.6.2 ephemeral BYOK vault (set BOTH on Vercel)
# REDIS_URL=rediss://user:password@your-managed-redis-host:6379
# CREDENTIAL_ENCRYPTION_KEY=generate_with_cryptography_fernet
