# =====================================================================
# WebBrief AI — Environment Configuration Template
# Copy this file to .env and configure your personal settings.
# NEVER commit your actual .env file or credentials to Git!
# =====================================================================

# ---------------------------------------------------------------------
# Primary AI Provider Configuration — Google Gemini Developer API
# Obtain your free or pay-as-you-go API key at:
# https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------------
PRIMARY_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_DEFAULT_MODEL=gemini-3.8-flash

# ---------------------------------------------------------------------
# Notion Integration (Optional — for exporting briefs to Notion)
# In local mode, saved to .env; in hosted mode, requires the encrypted Redis vault.
# ---------------------------------------------------------------------
# NOTION_API_KEY=secret_your_notion_integration_token_here

# ---------------------------------------------------------------------
# Flask Security Configuration (Required for production deployments)
# Production strictly requires an explicitly configured, secure secret key
# (minimum 32 characters / 16 bytes). Startup fails safely if missing or weak.
# In local development, an ephemeral 32-byte random key is generated automatically if empty.
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
# ---------------------------------------------------------------------
FLASK_SECRET_KEY=your_random_32_byte_secret_key_here
SESSION_COOKIE_SECURE=false

# ---------------------------------------------------------------------
# Server Runtime Configuration (Optional — defaults shown)
# ---------------------------------------------------------------------
FLASK_DEBUG=0
PORT=5000
HOST=127.0.0.1

# ---------------------------------------------------------------------
# Optional Redis Credential Vault & Distributed Rate Limiting
# When configured, visitor BYOK credentials are encrypted via Fernet in managed Redis
# without automatic expiration (indefinite persistence until explicit removal).
# Browser continuity is maintained via a long-lived HttpOnly `wb_vault_id` cookie
# mapped to SHA-256 hashed keys in Redis (`webbrief:credentials:<sha256>`).
# Recommended Redis configuration: AOF/RDB persistence enabled and `maxmemory-policy noeviction`.
# Also provides cross-instance rate limiting across serverless instances.
# When omitted, standard in-memory BYOK and process-local rate limiting are used.
# ---------------------------------------------------------------------
# REDIS_URL=rediss://default:your-password@your-managed-redis-host:6379
# Generate Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CREDENTIAL_ENCRYPTION_KEY=your_base64_fernet_encryption_key_here
