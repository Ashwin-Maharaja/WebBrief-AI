# =====================================================================
# WebBrief AI — Environment Configuration Template
# Copy this file to .env and configure your personal settings.
# NEVER commit your actual .env file or credentials to Git!
# =====================================================================

# OpenAI API Configuration (Required for webpage summarization & semantic search)
OPENAI_API_KEY=your_openai_api_key_here

# Notion Integration (Optional — for exporting briefs to Notion)
# NOTION_API_KEY=secret_your_notion_integration_token_here

# Flask Security Configuration (Required for production deployments)
# Generate a secure 32-byte secret key with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your_random_32_byte_secret_key_here
SESSION_COOKIE_SECURE=false

# Server Runtime Configuration (Optional — defaults shown)
FLASK_DEBUG=0
PORT=5000
HOST=127.0.0.1


